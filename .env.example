# 실제 값은 저장소에 올리지 않는다. 받는 방법: npx vercel env pull .env.local
# Vercel 의 Supabase 연동이 아래 값을 자동으로 넣는다.

# 브라우저·서버 (공개 키, RLS 적용)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버·스크립트 전용 (RLS 를 건너뛴다. 브라우저 코드에서 쓰지 않는다)
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL_NON_POOLING=

# 시연 계정(npm run seed:company) 비밀번호. 6자 이상(Supabase 최소 길이), 저장소에 올리지 않는다
SEED_PASSWORD=

# AI (서버만). 제공자 OpenAI. 시드 프로필 사진 만들기(npm run seed:avatars, 비용이 든다)도 이 키를 쓴다
OPENAI_API_KEY=
