# 실제 값은 저장소에 올리지 않는다. 받는 방법: npx vercel env pull .env.local
# Vercel 의 Supabase 연동이 아래 값을 자동으로 넣는다.

# 브라우저·서버 (공개 키, RLS 적용)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버·스크립트 전용 (RLS 를 건너뛴다. 브라우저 코드에서 쓰지 않는다)
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL_NON_POOLING=

# 시연 계정(npm run seed:users) 비밀번호. 8자 이상, 저장소에 올리지 않는다
SEED_PASSWORD=

# AI (서버만). 제공자 OpenAI. 가격은 100만 토큰당 달러 (없으면 비용 0 으로 기록)
# gpt-4o-mini 표준 가격: 입력 0.15, 출력 0.60 (2026-09-29 OpenAI 가격 페이지). 모델을 바꾸면 가격도 바꾼다
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_PRICE_INPUT_PER_1M=0.15
OPENAI_PRICE_OUTPUT_PER_1M=0.60
